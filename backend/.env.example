NODE_ENV=development
PORT=port_number

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/PROJECT_NAME?schema=public"

# JWT
JWT_SECRET=very_secure_jwt_secret_key_that_should_be_long_and_rando
JWT_REFRESH_SECRET=another_secure_refresh_secret_key_for_jwt_tokens_that_should_be_long_and_random
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL (for frontend API calls)
BACKEND_URL=http://localhost:port_number

# Mail (configure with your SMTP provider)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Portfolio Contact <your@gmail.com>"
OWNER_EMAIL=your@gmail.com

# Admin seed password
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=Admin@123456